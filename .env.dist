PORT=3000
GO_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_MAX_AGE=86400
RATE_LIMIT_MAX=100

###> postgres ###
POSTGRES_VERSION=16
POSTGRES_DB=db
POSTGRES_USER=random
POSTGRES_PASSWORD=random
POSTGRES_NAME=database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_NAME}:5432/${POSTGRES_DB}?sslmode=disable
###< postgres ###

###> ngrok/ngrok ###
NGROK_AUTHTOKEN=
###< ngrok/ngrok ###

###> clerk/clerk-go ###
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
###< clerk/clerk-go ###

###> kafka ###
KAFKA_BROKERS=kafka:9092
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_TLS=false
KAFKA_API_PASSWORD=
KAFKA_SCHEDULER_PASSWORD=
KAFKA_WORKER_PASSWORD=
KAFKA_WORKER_CALLS_PASSWORD=
OUTBOX_POLL_INTERVAL=1s
WORKER_CONCURRENCY=8
###< kafka ###

###> secrets ###
SECRETS_ENCRYPTION_KEY=
JOB_SEAL_PUBLIC_KEY=
JOB_SEAL_PRIVATE_KEY=
###< secrets ###

###> scheduler ###
RESULTS_RETENTION_DAYS=30
SCHEDULER_MAX_JITTER=5s
HEARTBEAT_URL=
###< scheduler ###

###> worker-calls ###
SSRF_ALLOW_PRIVATE=false
HTTP_MIN_TLS_VERSION=1.2
###< worker-calls ###

###> centrifugo/centrifugo ###
CENTRIFUGO_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=dev-centrifugo-token-secret
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://localhost:3001
CENTRIFUGO_PUBLIC_WS_URL=ws://localhost:8000/connection/websocket
###< centrifugo/centrifugo ###

###> storage / s3 ###
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_INTERNAL_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=devuser
STORAGE_SECRET_KEY=devpassword
STORAGE_BUCKET=bodies
###< storage / s3 ###
